(defwindow gamelaunch
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0px"
                               :width "90%"
                               :height "80%"
                               :anchor "center")
           :stacking "overlay"
           :exclusive false
  (main)
  )

(defwidget game [name image run ?alt-run]
  (eventbox
    :class "game-box"
    :onclick "${run} && eww close gamelaunch"
    :onrightclick "${alt-run}"
    :cursor "pointer"
    (tooltip
      (label
        :class "game-label"
        :text "${name}")
      (image
        :class "game-image"
        :path "${image}"
        :image-height 198
        )
      )
    )
  )

(defwidget main []
  (scroll
    :class "scrollable"
    :vscroll true
    :hscroll false
    (box
      :class "vertical-box"
      :orientation "v"
      :space-evenly false
      (box
        :class "horizontal-box"
        :orientation "h"
        :space-evenly false
        (game
          :name "Steam"
          :image "/tmp/user-config/eww/widgets/game-launcher/steam.png"
          :run "steam"
          )
        (game
          :name "Elite"
          :image "/tmp/user-config/eww/widgets/game-launcher/elite.jpg"
