{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    },
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo/blossom.txt"
  },
  "display": {
    "separator": ""
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "format": "{#dim_white}┃{#} {#38;2;255;234;240} {user-name} | 󰍹 {host-name} {#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    {
      "type": "os",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240} {#}",
      "format": "{#38;2;255;234;240}{pretty-name}{#}"
    },
    {
      "type": "kernel",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰒋 {#}",
      "format": "{#38;2;255;234;240}{release}{#}"
    },
    {
      "type": "uptime",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰅐 {#}",
      "format": "{#38;2;255;234;240}{days}d {hours}:{minutes}:{seconds}{#}"
    },
    {
      "type": "packages",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰏖 {#}",
      "format": "{#38;2;255;234;240}{pacman} (pacman){#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    {
      "type": "wm",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󱂬 {#}",
      "format": "{#38;2;255;234;240}{pretty-name} {version}{#}"
    },
    {
      "type": "theme",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240} {#}",
      "format": "{#38;2;255;234;240}{theme2}{#}"
    },
    {
      "type": "cursor",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰇀 {#}",
      "format": "{#38;2;255;234;240}{theme} ({size}){#}"
    },
    {
      "type": "display",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰹑 {#}",
      "format": "{#38;2;255;234;240}{width}x{height} {refresh-rate}Hz {inch}\"{#}"
    },
    {
      "type": "shell",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240} {#}",
      "format": "{#38;2;255;234;240}{pretty-name} {version}{#}"
    },
    {
      "type": "terminal",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240} {#}",
      "format": "{#38;2;255;234;240}{pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰛖 {#}",
      "format": "{#38;2;255;234;240}{combined}{#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    {
      "type": "cpu",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240} ",
      "format": "{#38;2;255;234;240}{name}{#}"
    },
    {
      "type": "gpu",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰢮 {#}",
      "format": "{#38;2;255;234;240}{name}{#}"
    },
    {
      "type": "memory",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240} {#}",
      "format": "{#38;2;255;234;240}{used} / {total} ({percentage}){#}"
    },
    {
      "type": "swap",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰋊 {#}",
      "format": "{#38;2;255;234;240}{used} / {total} ({percentage}){#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    {
      "type": "disk",
      "key": "{#dim_white}┃{#} {#38;2;255;234;240}󰋊 {#}",
      "format": "{#38;2;255;234;240}{name}  {size-used} / {size-total} ({size-percentage}){#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    {
      "type": "colors",
      "symbol": "block"
    },
    {
      "type": "custom",
      "format": ""
    }
  ]
}
