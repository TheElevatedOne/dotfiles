{
  "name": "top-bar",
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "output": "HDMI-A-1",
  "height": 24,
  "margin-top": 10,
  "margin-bottom": 10,
  "margin-left": 20,
  "margin-right": 20,
  "reload_style_on_change": true,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "include": [
    "$HOME/.config/waybar/modules/modules-left.json",
    "$HOME/.config/waybar/modules/modules-center.json",
    "$HOME/.config/waybar/modules/modules-right.json"
  ],
  "modules-left": [
    "group/power",
    "hyprland/workspaces",
    "group/windows",
    "group/sysmon",
    "group/wthr"
  ],
  "modules-center": [
    "group/center"
  ],
  "modules-right": [
    "group/workaround2",
    "group/keyboard",
    "group/lighting",
    "group/devices",
    "group/batt",
    "group/notif"
  ]
}
