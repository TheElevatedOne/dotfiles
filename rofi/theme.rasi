/*******************************************************************************
 * ROUNDED THEME FOR ROFI 
 * User                 : LR-Tech               
 * Theme Repo           : https://github.com/lr-tech/rofi-themes-collection
 *******************************************************************************/

* {
    font:               "GeistMono Nerd Font 14";
    background-color:   transparent;
    text-color:         @forelight;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    anchor: center;
    location: south;
    width:              40%;
    height:             52%;
    background-color:   @backlight;
    border-radius:      24px;
    y-offset: -50px;
}

mainbox {
    padding:    12px;

}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;
    margin:     12px 0 0;
    lines:      8;
    columns:    1;
    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @bg3;
}

element selected normal, element selected active {
    background-color:   @bg3;
}

element-icon {
    size:               1em;
    vertical-align:     0.5;
}

element-text {
    text-color: inherit;
}
