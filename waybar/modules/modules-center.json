{
  "custom/lp-clock": {
    "format": "",
    "tooltip": false
  },
  "custom/date": {
    "format": "{text}",
    "interval": 1,
    "exec": "$HOME/.config/waybar/scripts/get-date",
    "return-type": "json",
    "restart-interval": 1
  },
  "custom/mp-clock": {
    "format": "",
    "tooltip": false
  },
  "custom/clock": {
    "format": "{text}",
    "interval": 1,
    "exec": "$HOME/.config/waybar/scripts/get-time",
    "return-type": "json",
    "restart-interval": 1
  },
  "custom/rp-clock": {
    "format": "",
    "tooltip": false
  }
}
